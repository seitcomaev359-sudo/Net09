import os
import requests
from telegram import Update
from telegram.ext import Application, CommandHandler, ContextTypes

TOKEN = os.getenv("8409219395:AAEB4u-Ui_D00heq5EDl6pkG9gWDkF7BTwI")


def check_ip(ip):
    try:
        r = requests.get(f"https://ipinfo.io/{ip}/json", timeout=5)
        data = r.json()
        return data.get("country", "unknown"), data.get("org", "unknown")
    except:
        return "error", "error"


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("VPN Checker ready\nUse /check IP")


async def check(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if not context.args:
        await update.message.reply_text("Use: /check IP")
        return

    ip = context.args[0]
    country, org = check_ip(ip)

    await update.message.reply_text(
        f"{ip}\nCountry: {country}\nOrg: {org}"
    )


app = Application.builder().token(TOKEN).build()

app.add_handler(CommandHandler("start", start))
app.add_handler(CommandHandler("check", check))

app.run_polling()
